# Supabase Configuration
# Required for connecting to Supabase PostgreSQL, Auth, and Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: GEMINI_API_KEY must NEVER be placed in VITE_* frontend variables.
# It is configured securely as a Supabase secret inside Supabase Edge Functions:
# supabase secrets set GEMINI_API_KEY=your_gemini_api_key
